# Coordinator (all optional; keys are generated and stored in the data volume when empty)
GPUPOOL_ADMIN_KEY=
GPUPOOL_CLUSTER_TOKEN=
GPUPOOL_API_KEYS=
GPUPOOL_PUBLIC_URL=
GPUPOOL_WEBHOOK_URL=
HF_TOKEN=
# Folder with your .gguf files on THIS machine, mounted read-only at /models in the container.
# Use an ABSOLUTE path (a user types absolute paths in the UI, and the coordinator maps this
# host path to /models). Forward slashes only. Symlinks inside must point inside this folder.
GPUPOOL_HOST_MODELS_DIR=/srv/gguf

# Agent (per server). GPUPOOL_JOIN is printed in the coordinator log.
GPUPOOL_JOIN=http://10.0.0.1:8080#<cluster_token>
# Optional: defaults are the hostname and the auto-detected IP
# GPUPOOL_NODE_ID=server-a
# GPUPOOL_HOST=10.0.0.5
CUDA_ARCHS=61;70;75;80;86;89;90;120

# Corporate HTTP proxy (optional). Used only for traffic leaving the cluster (Hugging Face,
# model URLs, alert webhook) and while building images; never between coordinator, servers and
# llama.cpp. Lowercase wins over uppercase. no_proxy: hosts, .domain suffixes, IPs, CIDRs, *.
# http_proxy=http://proxy.corp.local:3128
# https_proxy=http://proxy.corp.local:3128
# no_proxy=localhost,127.0.0.1,.corp.local,10.0.0.0/8,192.168.0.0/16

# Building without GitHub (all optional; see vendor/README.md)
# Put vendor/llama.cpp-b11342.tar.gz in the repo, or point to an internal mirror of the archive:
# LLAMA_CPP_URL=https://mirror.corp.local/llama.cpp/b11342.tar.gz
# Registry mirror for the uv image (both images). Coordinator only: install uv from PyPI instead.
# UV_IMAGE=registry.corp.local/astral-sh/uv:0.10
# UV_FROM_PYPI=1
# Agent: managed Python 3.12 archives (python-build-standalone). A local folder is
# vendor/python, mounted at /vendor during the build:
# UV_PYTHON_INSTALL_MIRROR=file:///vendor/python
# Agent: skip llama-server's web UI download from Hugging Face (gpupool does not use it)
# LLAMA_USE_PREBUILT_UI=OFF
