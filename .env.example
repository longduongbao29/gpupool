# Coordinator (all optional; keys are generated and stored in the data volume when empty)
GPUPOOL_ADMIN_KEY=
GPUPOOL_CLUSTER_TOKEN=
GPUPOOL_API_KEYS=
GPUPOOL_PUBLIC_URL=
GPUPOOL_WEBHOOK_URL=
HF_TOKEN=
GPUPOOL_HOST_MODELS_DIR=./models

# Agent (per server). GPUPOOL_JOIN is printed in the coordinator log.
GPUPOOL_JOIN=http://10.0.0.1:8080#<cluster_token>
# Optional: defaults are the hostname and the auto-detected IP
# GPUPOOL_NODE_ID=server-a
# GPUPOOL_HOST=10.0.0.5
CUDA_ARCHS=61;70;75;80;86;89;90

# Corporate HTTP proxy (optional). Used only for traffic leaving the cluster (Hugging Face,
# model URLs, alert webhook) and while building images; never between coordinator, servers and
# llama.cpp. Lowercase wins over uppercase. no_proxy: hosts, .domain suffixes, IPs, CIDRs, *.
# http_proxy=http://proxy.corp.local:3128
# https_proxy=http://proxy.corp.local:3128
# no_proxy=localhost,127.0.0.1,.corp.local,10.0.0.0/8,192.168.0.0/16
